# Place values in Vercel Preview environment settings; never commit real values.
APP_ENV=production
LLM_PROVIDER=ollama
OLLAMA_API_KEY=REPLACE_IN_VERCEL
OLLAMA_MODEL=gemma4:cloud
OLLAMA_HOST=https://ollama.com
OLLAMA_FALLBACK_TO_OPENROUTER=false
# Required only if explicitly enabling fallback:
# OPENROUTER_API_KEY=REPLACE_IN_VERCEL
LLM_TIMEOUT=60
BACKEND_API_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
BACKEND_REQUEST_DEADLINE=150
BACKEND_RATE_BACKEND=redis
BACKEND_RATE_LIMIT=30
BACKEND_MAX_CONCURRENT=4
BACKEND_RATE_NAMESPACE=interviewiq-preview
UPSTASH_REDIS_REST_URL=https://REPLACE_WITH_MANAGED_REDIS_ENDPOINT
UPSTASH_REDIS_REST_TOKEN=REPLACE_IN_VERCEL
