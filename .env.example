OPENROUTER_API_KEY=your_key_here
LLM_PROVIDER=open-router
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:cloud
OLLAMA_HOST=https://ollama.com
OLLAMA_FALLBACK_TO_OPENROUTER=false
LLM_TIMEOUT=60
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
XAI_API_KEY=
GROK_MODEL=grok-4.3

IS_FREE_MODE=true
DEFAULT_MODEL=google/gemma-4-31b-it:free
MODEL_NAME=google/gemma-4-31b-it:free
TEMPERATURE=0.7

ALLOWED_PROVIDERS=["openrouter", "grok", "google"]
BLOCK_DATA_COLLECTING=true

PRIMARY_PROVIDER=open-router
FALLBACK_PROVIDERS=["grok", "google"]

QUESTION_GENERATION_PROVIDERS=["open-router"]
QUESTION_GENERATION_FALLBACKS=[]

# Set the same random secret in the backend and Streamlit server environments.
BACKEND_API_SECRET=
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_API_TIMEOUT=180
BACKEND_RATE_LIMIT=30
BACKEND_MAX_CONCURRENT=4

# local | test | production (Vercel defaults to production)
APP_ENV=local
BACKEND_REQUEST_DEADLINE=150
# memory for local/test; production requires redis.
BACKEND_RATE_BACKEND=memory
BACKEND_RATE_NAMESPACE=interviewiq
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required for anonymous Redis quotas; a separate random secret of at least 32 bytes.
# Configure identically on backend and trusted Streamlit server only.
BACKEND_VISITOR_SIGNING_KEY=
BACKEND_VISITOR_RATE_LIMIT=10
BACKEND_VISITOR_DAILY_LIMIT=100
BACKEND_GLOBAL_DAILY_LIMIT=1000
BACKEND_INGRESS_RATE_LIMIT=300
